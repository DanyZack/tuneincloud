---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import ArticleBanner from '../components/ArticleBanner.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  pageType?: 'article' | 'profile';
};

const { title, description, pubDate, updatedDate, category, subcategory, heroImage, pageType = 'article' } = Astro.props;
const isArticle = pageType === 'article';
---

<html lang="fr">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      type={pageType}
      pubDate={isArticle ? pubDate : undefined}
      updatedDate={isArticle ? updatedDate : undefined}
    />
  </head>

  <body>
    <Header />
    <main>
      <article>

        <!-- Bannière automatique selon catégorie/subcategory -->
        <ArticleBanner
			title={title}
			category={category ?? 'actualites'}
			subcategory={subcategory}
			pubDate={pubDate}
			heroImage={heroImage}
		/>

        <!-- Contenu de l'article -->
        <div class="prose">
          {isArticle && (
            <p class="byline">
              Par <a href="/about/" rel="author">Daniel POLÒNIO</a>
            </p>
          )}
          {updatedDate && (
            <p class="last-updated">
              Mis à jour le {updatedDate.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
          )}
          <slot />
        </div>

      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
main {
  width: 100%;
  margin: 0;
}

.prose {
  width: 850px;
  max-width: calc(100% - 2rem);
  margin: 3rem auto;
  padding: 0 1rem;
  font-family: 'Raleway', sans-serif;
  font-size: 1rem;
  font-weight: 400;
  line-height: 1.8;
  color: #3d3d5c;
}

.byline {
  font-size: 0.82rem;
  letter-spacing: 0.08em;
  color: #7a7a9a;
  margin-bottom: 0.5rem;
}

.byline a {
  color: #1a2b5e;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid rgba(184, 151, 42, 0.4);
}

.byline a:hover {
  color: #b8972a;
}

.last-updated {
  font-size: 0.78rem;
  color: #b8972a;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 2rem;
  font-style: italic;
}
</style>
